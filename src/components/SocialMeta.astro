---
interface Props {
  title: string;
  description: string;
  url: URL;
  locale?: string;
  localeAlternates?: string[];
  image?: URL;
  imageAlt?: string;
}

const { title, description, url, locale = 'es_ES', localeAlternates = [] } = Astro.props;
const custom = Astro.props.image;
const image = custom ?? new URL('/brand/bootdevelop-social-v3.jpg', Astro.site!);
const imageAlt = Astro.props.imageAlt ?? (custom ? title : 'Bootdevelop logo with a Let’s build call to action and a code symbol above flowing blue ribbons.');
---
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Bootdevelop" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={locale} />
{localeAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
{!custom && <meta property="og:image:type" content="image/jpeg" />}
{!custom && <meta property="og:image:width" content="1200" />}
{!custom && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
