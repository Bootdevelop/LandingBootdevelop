---
interface Props {
  title: string;
  description: string;
  url: URL;
  locale?: string;
}

const { title, description, url, locale = 'es_ES' } = Astro.props;
const image = new URL('/brand/bootdevelop-social-v1.jpg', Astro.site!);
const imageAlt = 'Bootdevelop — blue gradient logo above flowing blue ribbons on an off-white background';
---
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Bootdevelop" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={locale} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
