---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';
import { langs, type Lang } from '../i18n/ui';
import { alternates, type Page } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const site = Astro.site!;
const alt = alternates(page);
const canonical = new URL(alt[lang], site);
const ogLocale = { es: 'es_ES', en: 'en_US', fr: 'fr_FR' }[lang];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(alt[l], site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafafa" />

    <SocialMeta title={title} description={description} url={canonical} locale={ogLocale} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Bootdevelop',
      url: site.href,
      logo: new URL('/brand/logo.png', site).href,
      email: 'support@bootdevelop.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
    })} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header lang={lang} page={page} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
  </body>
</html>
