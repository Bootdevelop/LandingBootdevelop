---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 | Bootdevelop</title>
    <link rel="icon" href="/favicon.ico" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="grid min-h-dvh place-items-center px-4">
    <main class="text-center">
      <img src="/brand/logo.png" alt="Bootdevelop" width="422" height="76" class="mx-auto h-7 w-auto" />
      <p class="mt-12 font-mono text-sm text-brand-600">404</p>
      <h1 class="mt-3 text-4xl font-medium tracking-[-0.04em]">Página no encontrada</h1>
      <p class="mt-2 text-muted-foreground">Page not found · Page introuvable</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/es/" class="btn btn-primary">Inicio</a>
        <a href="/en/" class="btn btn-ghost">Home</a>
        <a href="/fr/" class="btn btn-ghost">Accueil</a>
      </div>
    </main>
  </body>
</html>
